      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"\",\n  \"description\": \"Пустой type\",\n  \"occurredAt\": \"2026-08-23T10:30:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        }
      }
    },
    {
      "name": "Create event - description > 200 (400)",
      "request": {
        "method": "POST",
        "header": [
          {
