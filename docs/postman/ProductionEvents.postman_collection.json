    "name": "Production Events API",
    "description": "Коллекция для проверки REST API /api/events",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create event - valid (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"MACHINE_STARTED\",\n  \"description\": \"Линия фасовки запущена\",\n  \"occurredAt\": \"2026-08-23T10:30:00\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        }
      }
    },
    {
      "name": "Get all events (200)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"]
        }
      }
    },
    {
      "name": "Get all events by type (200)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/events?type=MACHINE_STARTED",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events"],
          "query": [
            {
              "key": "type",
              "value": "MACHINE_STARTED"
            }
          ]
        }
      }
    },
    {
      "name": "Get event by id = 1 (200 or 404)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/events/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "events", "1"]
        }
      }
    },
    {
