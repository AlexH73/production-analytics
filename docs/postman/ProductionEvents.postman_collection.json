      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"MACHINE_STARTED\",\n  \"description\": \"Без occurredAt\",\n  \"occurredAt\": null\n}"
